{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "automaticffl/dealer-selection-shipping",
	"version": "1.0.0",
	"title": "FFL Dealer Selection",
	"category": "woocommerce",
	"description": "Allows customers to select an FFL dealer for firearm and restricted ammunition orders.",
	"textdomain": "automaticffl-for-wc",
	"supports": {
		"html": false,
		"align": false,
		"multiple": false,
		"reusable": false,
		"inserter": false
	},
	"parent": [
		"woocommerce/checkout-shipping-address-block"
	],
	"attributes": {
		"lock": {
			"type": "object",
			"default": {
				"remove": true,
				"move": true
			}
		}
	}
}
